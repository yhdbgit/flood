{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yhdbgit/flood/schema/guidance_context_v18.schema.json",
  "title": "Flood Guidance Context V18",
  "type": "object",
  "required": [
    "schema_version",
    "context_id",
    "generated_at",
    "status",
    "pilot",
    "field",
    "forecast",
    "hydrology",
    "inundation",
    "trigger",
    "actions",
    "shelter",
    "route",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "context_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "not_triggered", "cooldown", "unavailable"]},
    "pilot": {
      "type": "object",
      "required": ["location_label", "timezone"],
      "properties": {
        "location_label": {"type": "string"},
        "timezone": {"const": "Asia/Seoul"}
      },
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": ["field_id", "display_name", "centre_wgs84", "geometry_accuracy"],
      "properties": {
        "field_id": {"type": "string"},
        "display_name": {"type": "string"},
        "centre_wgs84": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        },
        "geometry_accuracy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "forecast": {
      "type": "object",
      "required": ["status", "source", "base_datetime", "target_date", "grid", "coverage", "rain_24h"],
      "properties": {
        "status": {"enum": ["complete", "incomplete", "unavailable"]},
        "source": {"type": "object"},
        "base_datetime": {"type": ["string", "null"]},
        "target_date": {"type": ["string", "null"]},
        "grid": {"type": "object"},
        "coverage": {"type": "object"},
        "rain_24h": {"type": "object"}
      },
      "additionalProperties": true
    },
    "hydrology": {
      "type": "object",
      "required": ["status", "used_for_trigger"],
      "properties": {
        "status": {"enum": ["ok", "unavailable"]},
        "used_for_trigger": {"const": false}
      },
      "additionalProperties": true
    },
    "inundation": {
      "type": "object",
      "required": ["dataset_id", "field_affected_percent", "condition_role", "hydraulic_event_forecast"],
      "properties": {
        "dataset_id": {"type": "string"},
        "field_affected_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "condition_role": {"const": "official_hazard_overlap_proxy"},
        "hydraulic_event_forecast": {"const": false}
      },
      "additionalProperties": true
    },
    "trigger": {
      "type": "object",
      "required": ["should_generate_video", "rain_condition", "field_condition", "cooldown", "reason_codes"],
      "properties": {
        "should_generate_video": {"type": "boolean"},
        "rain_condition": {"type": "object"},
        "field_condition": {"type": "object"},
        "cooldown": {"type": "object"},
        "reason_codes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "actions": {"type": "object"},
    "shelter": {"type": "object"},
    "route": {"type": "object"},
    "provenance": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
