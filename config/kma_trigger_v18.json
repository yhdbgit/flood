{
  "schema_version": "1.0",
  "dataset_id": "OSONG-KMA-TRIGGER-V18",
  "timezone": "Asia/Seoul",
  "kma": {
    "api_url": "https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getVilageFcst",
    "service_key_env": "KMA_SERVICE_KEY",
    "base_time": "0500",
    "availability_delay_minutes": 15,
    "forecast_category": "PCP",
    "required_hour_count": 24,
    "max_base_age_hours": 30,
    "grid_source": "registered_field_centroid_lambert_conformal_conic"
  },
  "trigger": {
    "rain_threshold_mm": 80.0,
    "rain_total_field": "representative_estimate_mm",
    "field_overlap_threshold_percent": 10.0,
    "cooldown_hours": 48,
    "require_complete_24h": true
  },
  "inputs": {
    "field": "config/osong_farmland_v11.json",
    "inundation": "data/processed/osong_inundation_v16.json",
    "hydrology": "data/runtime/osong_realtime_state_v17.json",
    "guidance": "config/guidance_policy.json",
    "shelter_route": "config/osong_guidance_input_v13.json"
  },
  "outputs": {
    "forecast": "data/runtime/kma_forecast_v18.json",
    "context": "data/runtime/guidance_context_v18.json",
    "dispatch_history": "data/runtime/v18_dispatch_history.json"
  },
  "policies": {
    "forecast_is_primary_day_before_trigger": true,
    "hrfco_is_current_state_confirmation_only": true,
    "field_condition_is_official_hazard_overlap_proxy": true,
    "hydraulic_event_forecast_claimed": false,
    "rain_threshold_status": "mvp_calibrated_candidate_not_operational_standard",
    "dispatch_history_is_recorded_only_after_explicit_success_signal": true
  }
}
